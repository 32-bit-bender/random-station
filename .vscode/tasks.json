{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_TOOLCHAIN_FILE=cmake/arm-gcc.cmake"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cmake --build build",
            "dependsOn": "configure",
      "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "flash",
            "type": "shell",
            "command": "cmake --build build --target flash"
        }
    ]
}
